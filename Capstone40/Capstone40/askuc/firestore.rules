rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read: if true;
      allow create: if request.auth != null && (
        request.auth.uid == studentId ||
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.uid != null
      );
      allow update: if request.auth != null && (
        request.auth.uid == studentId ||
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.uid != null
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.uid != null
      );
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid != null;
    }

    match /chatbotQueries/{queryId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin';
    }

    match /navigationSearches/{searchId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin';
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['rating', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['rating', 'message', 'createdAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid != null;
    }

    match /blockedWords/{wordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.keys().hasOnly([
          'word', 'normalizedWord', 'language', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'word', 'normalizedWord', 'language', 'createdAt'
        ])
        && request.resource.data.word is string
        && request.resource.data.word.size() > 0
        && request.resource.data.word.size() <= 80
        && request.resource.data.normalizedWord is string
        && request.resource.data.language in [
          'English', 'Tagalog', 'Cebuano', 'Mixed / Other'
        ]
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin';
      allow update: if false;
    }
  }
}
